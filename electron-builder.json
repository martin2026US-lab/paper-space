{
  "appId": "io.github.martin2026us-lab.paper-space",
  "productName": "纸间",
  "asar": false,
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "desktop/**",
    "public/**",
    "python/parse_pdf.py",
    "server.mjs",
    "pdf-service.mjs",
    "package.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!public/demo.pdf",
    "model-service.mjs",
    "translation-service.mjs",
    "python/download_models.py",
    "python/requirements.txt",
    "python/constraints-windows.txt",
    "python/constraints-macos-arm64.txt",
    "quality-service.mjs",
    "recognition-service.mjs"
  ],
  "mac": {
    "target": [{"target": "dmg", "arch": ["arm64"]}],
    "category": "public.app-category.productivity",
    "icon": "desktop/icon.icns",
    "artifactName": "Paper-Space-${version}-macOS-${arch}.${ext}",
    "minimumSystemVersion": "14.0",
    "identity": "-",
    "hardenedRuntime": false,
    "notarize": false
  },
  "dmg": {
    "sign": false,
    "title": "Paper Space ${version}",
    "contents": [
      {"x": 140, "y": 160},
      {"x": 420, "y": 160, "type": "link", "path": "/Applications"}
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "desktop/icon.ico",
    "artifactName": "Paper-Space-${version}-Windows-x64-Setup.${ext}",
    "signExecutable": false,
    "signAndEditExecutable": false
  },
  "nsis": {
    "include": "build/installer.nsh",
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "纸间 Paper Space",
    "runAfterFinish": false,
    "deleteAppDataOnUninstall": false,
    "installerLanguages": [
      "zh_CN",
      "en_US"
    ],
    "language": "2052",
    "displayLanguageSelector": true,
    "installerIcon": "desktop/icon.ico",
    "uninstallerIcon": "desktop/icon.ico"
  },
  "publish": null
}

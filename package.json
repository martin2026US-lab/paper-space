{
  "name": "paper-space-local",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "dev": "electron . --debug",
    "test": "node --test tests/*.test.mjs",
    "setup:demo": "node scripts/download-demo.mjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "纸间 · A local-first AI paper reading workspace",
